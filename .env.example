# Date personale, folosite doar pentru a interoga calendarul ASP (nu se salveaza in state).
# Valorile de mai jos sunt FICTIVE -- pune datele reale doar in .env (ignorat de git).
ASP_IDNP=2000000000000
ASP_DOC_SERIES=AB1234567
# Format ISO cu ora 00:00:00
ASP_DOC_ISSUE_DATE=2020-01-01T00:00:00

# Bot Telegram (@BotFather) si chat-ul destinatie
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Doar pentru webhook-ul de pe Vercel (api/telegram-webhook.js) -- nefolosit local de
# src/index.js. Sir random; Telegram il trimite inapoi pe fiecare cerere de webhook.
TELEGRAM_WEBHOOK_SECRET=

# Doar pentru checkerul periodic de pe Vercel (api/cron-check.js) -- nefolosit local de
# src/index.js. Sir random; cron-job.org (sau orice alt cron extern) il trimite ca
# "Authorization: Bearer <CRON_SECRET>" la fiecare apel. Fara el, oricine ar putea
# declansa verificarea (si, mai grav, ar putea sa o declanseze suficient de des incat sa
# ne blocheze IP-ul la ASP). Genereaza-l la fel ca TELEGRAM_WEBHOOK_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Doar pentru webhook + cron-check -- nefolosit local de src/index.js. Obligatoriu pentru
# cron-check.js (tine state-ul checkerului si lock-ul impotriva rularilor suprapuse).
# Pentru webhook.js e optional: fara el, doar proprietarul (TELEGRAM_CHAT_ID) poate folosi
# botul; cu el, orice alt chat isi poate introduce propriile date prin /inregistrare si
# folosi botul in numele lui (vezi src/registration.js + userStore.js).
# Connection string standard Redis (redis://default:PASSWORD@host:port) -- orice provider
# (Redis Cloud, Upstash in modul TCP, self-hosted). Prefera `rediss://` (TLS) daca
# provider-ul il ofera.
REDIS_URL=

# Doar pentru webhook, obligatoriu impreuna cu REDIS_URL -- cheia AES-256-GCM cu care
# sunt criptate datele altor persoane (IDNP/serie/data) inainte sa ajunga in Redis.
# NEfolosita de cron-check.js (state-ul checkerului nu contine date personale, vezi
# userStore.js). 32 bytes random, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Daca o schimbi, datele deja salvate devin ilizibile (userii se reinregistreaza).
USER_DATA_KEY=
