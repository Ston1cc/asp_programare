# Date personale, folosite doar pentru a interoga calendarul ASP (nu se salveaza in state)
ASP_IDNP=2008500150483
ASP_DOC_SERIES=EA0039316
# Format ISO cu ora 00:00:00
ASP_DOC_ISSUE_DATE=2025-05-16T00:00:00

# Bot Telegram (@BotFather) si chat-ul destinatie
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Doar pentru webhook-ul de pe Vercel (api/telegram-webhook.js) -- nefolosit local de
# src/index.js. Sir random; Telegram il trimite inapoi pe fiecare cerere de webhook.
TELEGRAM_WEBHOOK_SECRET=

# Doar pentru webhook -- optional. Fara el, doar proprietarul (TELEGRAM_CHAT_ID) poate
# folosi botul; cu el, orice alt chat isi poate introduce propriile date prin
# /inregistrare si folosi botul in numele lui (vezi src/registration.js + userStore.js).
# Connection string standard Redis (redis://default:PASSWORD@host:port) -- orice provider
# (Redis Cloud, Upstash in modul TCP, self-hosted).
REDIS_URL=
