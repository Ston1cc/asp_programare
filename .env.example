# Date personale, folosite doar pentru a interoga calendarul ASP (nu se salveaza in state)
ASP_IDNP=2008500150483
ASP_DOC_SERIES=EA0039316
# Format ISO cu ora 00:00:00
ASP_DOC_ISSUE_DATE=2025-05-16T00:00:00

# Bot Telegram (@BotFather) si chat-ul destinatie
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Doar pentru webhook-ul de pe Vercel (api/telegram-webhook.js) -- nefolosit local de
# src/index.js. Sir random; Telegram il trimite inapoi pe fiecare cerere de webhook.
TELEGRAM_WEBHOOK_SECRET=

# Doar pentru webhook -- necesare ca sa poata scrie state/users.json (inregistrarile facute
# prin comanda /inregistrare) direct in acest repo, prin GitHub Contents API. Webhook-ul nu
# are un checkout de git persistent din care sa faca commit ca src/index.js in CI.
# GITHUB_TOKEN: PAT (fine-grained, doar acest repo, permisiune Contents: Read and write).
GITHUB_TOKEN=
GITHUB_REPO=Ston1cc/asp_programare
GITHUB_BRANCH=master
